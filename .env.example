# ──────────────────────────────────────────────────────
# Rewind — Environment Variables
# Copy to .env and fill in real values for your environment.
# ──────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://rewind:devpassword@localhost:5432/rewind

# Auth — shared secret between Next.js BFF proxy and FastAPI backend
BACKEND_SECRET=dev-backend-secret-change-in-production

# Azure Blob Storage (Azurite for local dev)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1"
AZURE_STORAGE_CONTAINER_NAME=sessions

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting (slowapi format)
API_RATE_LIMIT=100/minute

# Security limits
MAX_CONTENT_SIZE_BYTES=52428800
MAX_DECOMPRESSED_SIZE_BYTES=268435456
MAX_METADATA_SIZE_BYTES=2097152

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Trusted host (set to production domain; empty = no HSTS)
TRUSTED_HOST=

# Logging
LOG_LEVEL=INFO

# ── Frontend (packages/web/.env.local) ───────────────
# These go in packages/web/.env.local, NOT in the root .env

# For local dev without Google OAuth, use an API key to authenticate frontend→backend calls:
# NEXT_PUBLIC_API_KEY=rw_dev_local_key_1234567890abcdef1234567890abcdef

# For production with Google OAuth:
# NEXTAUTH_URL=https://rewind.dev.example.com
# AUTH_SECRET=<generate with: openssl rand -base64 32>
# AUTH_GOOGLE_ID=<from Google Cloud Console>
# AUTH_GOOGLE_SECRET=<from Google Cloud Console>
# BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_APP_NAME=Rewind
